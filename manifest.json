{
  "manifest_version": 3,
  "name": "Git Daily Summary",
  "version": "1.0.0",
  "description": "GitHub/Gitea 일일 커밋 요약 - AI 기반 자동 정리",
  "permissions": ["storage", "activeTab", "tabs", "scripting", "alarms", "notifications"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
